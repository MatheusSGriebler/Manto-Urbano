# Copie para .env apenas no desenvolvimento. Nunca envie .env ao Git.
NODE_ENV=development
PORT=3000
JWT_SECRET=
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Banco de dados (Supabase / PostgreSQL)
# Você pode usar DATABASE_URL (recomendado para Supabase + Vercel) OU as variáveis separadas abaixo:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=manto_urbano
# DB_SSL=true

# Em produção, configure o domínio do frontend, sem barra final.
# Separe múltiplos domínios por vírgula.
CORS_ORIGINS=http://localhost:5500

# Na Vercel, use TRUST_PROXY_HOPS=1 para o express-rate-limit identificar o IP corretamente.
# TRUST_PROXY_HOPS=1
