# Copie para .env apenas no desenvolvimento. Nunca envie .env ao Git.
NODE_ENV=development
PORT=3000
JWT_SECRET=
# Gere o segredo com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Desenvolvimento local (padrões locais também existem no código)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=manto_urbano

# Em produção, configure o domínio do frontend, sem barra final.
# Separe múltiplos domínios por vírgula.
CORS_ORIGINS=http://localhost:5500

# Configure apenas quando a hospedagem usar proxy reverso; informe a quantidade exata de proxies confiáveis.
# TRUST_PROXY_HOPS=1
