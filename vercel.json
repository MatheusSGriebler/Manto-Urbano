{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://ophahuumzszkshjldyjk.supabase.co; connect-src 'self' https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com;"
        }
      ]
    },
    {
      "source": "/(imgs|css|scripts)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(admin|cliente|checkout|carrinho)(\\.html)?",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/categorias(.*)", "destination": "/api/index.js" },
    { "source": "/ligas(.*)", "destination": "/api/index.js" },
    { "source": "/produtos(.*)", "destination": "/api/index.js" },
    { "source": "/imagens(.*)", "destination": "/api/index.js" },
    { "source": "/pedidos(.*)", "destination": "/api/index.js" },
    { "source": "/cadastro", "destination": "/api/index.js" },
    { "source": "/auth/login", "destination": "/api/index.js" },
    { "source": "/verificar-email", "destination": "/api/index.js" },
    { "source": "/enderecos(.*)", "destination": "/api/index.js" },
    { "source": "/webhooks/stripe", "destination": "/api/index.js" },
    { "source": "/camisetas", "destination": "/camisetas.html" },
    { "source": "/produto", "destination": "/produto.html" },
    { "source": "/sac", "destination": "/sac.html" },
    { "source": "/termos", "destination": "/termos.html" },
    { "source": "/politica", "destination": "/politica.html" },
    { "source": "/carrinho", "destination": "/carrinho.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/cliente", "destination": "/cliente.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
