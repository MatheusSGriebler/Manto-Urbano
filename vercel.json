{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/categorias(.*)", "destination": "/api/index.js" },
    { "source": "/ligas(.*)", "destination": "/api/index.js" },
    { "source": "/produtos(.*)", "destination": "/api/index.js" },
    { "source": "/imagens(.*)", "destination": "/api/index.js" },
    { "source": "/pedidos(.*)", "destination": "/api/index.js" },
    { "source": "/cadastro", "destination": "/api/index.js" },
    { "source": "/auth/login", "destination": "/api/index.js" },
    { "source": "/verificar-email", "destination": "/api/index.js" },
    { "source": "/enderecos(.*)", "destination": "/api/index.js" },
    { "source": "/webhooks/stripe", "destination": "/api/index.js" },
    { "source": "/camisetas", "destination": "/camisetas.html" },
    { "source": "/produto", "destination": "/produto.html" },
    { "source": "/sac", "destination": "/sac.html" },
    { "source": "/termos", "destination": "/termos.html" },
    { "source": "/politica", "destination": "/politica.html" },
    { "source": "/carrinho", "destination": "/carrinho.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/cliente", "destination": "/cliente.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
